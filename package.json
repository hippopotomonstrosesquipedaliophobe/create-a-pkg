    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.3",
    "@vvi/check-version": "^1.1.3",
    "@vvi/command": "^4.1.0",
    "@vvi/is": "^2.0.8",
    "@vvi/log": "^1.1.8",
    "@vvi/node": "^5.2.0",
    "@vvi/pen": "^3.0.5",
    "@vvi/pen-static": "^1.1.6",
    "@vvi/rollup-external": "^1.2.4",
    "@vvi/table": "^0.2.5",
