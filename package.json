{
  "name": "create-a-pkg",
  "type": "module",
  "version": "1.4.0",
  "scripts": {
    "b": "rollup --config rollup.config.js",
    "build": "jja cls rm dist && pnpm run b && node ./scripts/clean-package-json.js",
    "build:data": "node scripts/build-data.js",
    "prebuild": "pnpm run build:data",
    "predev": "pnpm run build:data",
    "diff": "jja pkg --diff 淘宝",
    "beautify": "prettier . --write",
    "lint": "eslint src --fix",
    "dev": "jja rm dist eg && pnpm run b && create_a_npm_dev=all node --trace-warnings  dist/bin.js -eg",
    "push:version": "gvv",
    "push": "gvv",
    "vjj": "vjj",
    "prepublishOnly": "pjj"
  },
  "jja": {
    "pkg": [
      "eslint",
      "typescript"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
